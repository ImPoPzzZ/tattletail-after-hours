// Recalled's saves are signed with a secret that is NOT in the repository.
// To build the mod: copy this file to RecalledSecret.cs and put a long random string in Value.
// Saves made with one secret can't be loaded by a build made with another, so keep the real one safe:
// if it's lost, every player's Recalled character is lost with it.
namespace KaleidoscopeEndless
{
    internal static class RecalledSecret
    {
        internal const string Value = "put-a-long-random-string-here";
    }
}
