<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless checks for the auto-updater's pure logic (src/UpdateCore.cs): the manifest, the signature, hashes and path safety.
       Usage: dotnet run on this project, then the folder made by tools/release/make_release.ps1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>SYSLIB0021;SYSLIB0022;SYSLIB0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\UpdateCore.cs" />
    <Compile Include="..\..\src\UpdateKey.cs" />
  </ItemGroup>
</Project>
